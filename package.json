{
  "name": "anubis",
  "version": "0.1.0",
  "private": true,
  "description": "Local Windows desktop orchestrator for serial AI development tasks",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/electron-vite-runner.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-vite-runner.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract:claude": "vitest run tests/contract/claude-provider.contract.test.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "electron": "36.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "electron-vite": "3.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.1"
  }
}
